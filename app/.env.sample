# Copy to `.env` and adjust. Never commit `.env` (it is gitignored).

# ── Server-side only (never exposed to the client) ──
# Base URL of your backend API. Used by server functions during SSR
# (see src/lib/server-fns.ts). Override in production via the container env
# (Docker: -e API_BASE_URL=...).
API_BASE_URL=https://api.example.com

# ── Client-side (public) — the browser-facing backend API base URL ──
# Exposed to client code via import.meta.env.VITE_API_BASE_URL and used by
# src/lib/api-client.ts. Must be the full URL (protocol + host).
VITE_API_BASE_URL=https://api.example.com
