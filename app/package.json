{
  "name": "tanstack-start-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/apply-router-plugin-patch.cjs",
    "postinstall": "node scripts/apply-router-plugin-patch.cjs",
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "gen:icons": "node scripts/generate-pwa-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
