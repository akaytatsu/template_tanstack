# ============================================================================
# Development Stage - Vite dev server (TanStack Start) com hot reload
# (npm run dev). Também pode ser usado pela CI para rodar lint/build/testes.
# ============================================================================
FROM node:22-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

WORKDIR /app

# Dependências de build (git p/ metadados de versão e módulos nativos).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instala dependências a partir do lockfile (npm ci) numa camada separada,
# aproveitando o cache do Docker enquanto package*.json não mudar. O scripts/
# precisa vir antes porque o postinstall roda apply-router-plugin-patch.cjs.
COPY package*.json ./
COPY scripts/ scripts/
RUN npm ci

# Copia o código (necessário para a CI, que não usa volume).
# Em dev local o docker-compose monta `./app:/app` por cima, habilitando hot
# reload; o volume anônimo em /app/node_modules preserva o que foi instalado
# aqui na imagem (o bind mount não o sobrescreve).
COPY . .

# Porta do Vite dev server
EXPOSE 5173

# Healthcheck simples — o Vite responde na raiz (retorna HTML)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:5173/').then(r => { process.exit(r.ok ? 0 : 1) }).catch(() => process.exit(1))"

# NOTE: this container deliberately runs as root. Dev containers need root for
# apt/git and for file permissions on bind-mounted volumes (especially macOS).
# The production Dockerfile switches to a non-root user (nodeuser).

# `--host` faz o Vite ouvir em 0.0.0.0 (acessível a partir do host)
CMD ["npm", "run", "dev", "--", "--host", "--port", "5173"]
